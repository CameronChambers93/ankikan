{
  "name": "furigana-extension",
  "version": "1.0.0",
  "description": "AnkiKan browser extension",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "node build.js",
    "dev": "web-ext run --source-dir .",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.js",
    "perf:fixtures": "node perf/fixtures/build-fixtures.js",
    "perf:micro": "node perf/micro/run.js",
    "perf:compare": "node perf/compare.mjs",
    "perf:baseline": "node perf/micro/run.js && node perf/compare.mjs --write-baseline",
    "perf:e2e": "playwright test --config=perf/playwright.perf.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.0",
    "kuromoji": "^0.1.2",
    "vitest": "^2.0.0",
    "web-ext": "^8.10.0"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "dexie": "^4.4.3",
    "zlibjs": "^0.3.1"
  }
}
