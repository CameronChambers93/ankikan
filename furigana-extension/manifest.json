{
  "manifest_version": 3,
  "name": "Anki Furigana Highlighter",
  "version": "1.0",
  "description": "Highlight Japanese vocabulary on web pages based on Anki card status.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "*://*/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ankikan@cameronchambers93",
      "data_collection_permissions": {
        "required": [],
        "optional": []
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*", "file:///*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Anki Furigana Highlighter"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
